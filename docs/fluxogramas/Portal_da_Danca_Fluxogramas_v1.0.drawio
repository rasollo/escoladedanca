/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="fluxo05" name="05 - Matrícula de alunos nas aulas"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="867" pageHeight="1351" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Fluxo 05 — Matrícula de alunos nas aulas" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="req" value="Requisitos: RF20, RF21, RF24, RN07, RN08, RN09  ·  Situação: Novo" style="text;html=1;fontSize=12;fontColor=#5a5768;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="nota" value="O que mudou: Fluxo novo: a inscrição abre uma matrícula com data de início; a saída encerra a matrícula com data de fim. É a base do salário (fluxo 11). Não é exigida para participar (RN08)." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1291" width="795" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="a" value="Selecionar aula agendada" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="264" width="214" height="56" as="geometry"/></mxCell><mxCell id="b" value="Exibir inscritos, capacidade da sala e vagas" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="380" width="214" height="56" as="geometry"/></mxCell><mxCell id="c" value="Marcar alunos a inscrever e desmarcar os que saíram" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="496" width="214" height="56" as="geometry"/></mxCell><mxCell id="d" value="Total de inscritos ≤ capacidade da sala?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="596" width="214" height="88" as="geometry"/></mxCell><mxCell id="r" value="Revisar seleção ou organizar outra turma" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613" y="612" width="204" height="56" as="geometry"/></mxCell><mxCell id="m1" value="Abrir matrícula (início = hoje) de cada aluno marcado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="m2" value="Encerrar matrícula (fim = hoje) de cada aluno desmarcado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="844" width="204" height="56" as="geometry"/></mxCell><mxCell id="au" value="Registrar a alteração na auditoria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="960" width="204" height="56" as="geometry"/></mxCell><mxCell id="s" value="Matrículas disponíveis para o cálculo do salário (fluxo 11)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometr