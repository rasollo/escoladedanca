: Fluxo novo: salário = alunos inscritos (matrículas ativas no mês) nas aulas do professor × valor por aluno. Cada par aluno–aula conta uma vez; avulsos não contam; faltas não reduzem o salário." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1639" width="800" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="a" value="Acessar salários" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="264" width="204" height="56" as="geometry"/></mxCell><mxCell id="b" value="Selecionar professor e mês" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="380" width="214" height="56" as="geometry"/></mxCell><mxCell id="c" value="Buscar matrículas das aulas do professor ativas em algum dia do mês" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="496" width="204" height="56" as="geometry"/></mxCell><mxCell id="d" value="Contar inscrições: cada par aluno–aula conta 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="612" width="204" height="56" as="geometry"/></mxCell><mxCell id="e" value="Salário = inscrições × valor por aluno do professor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="f" value="Exibir total e deta