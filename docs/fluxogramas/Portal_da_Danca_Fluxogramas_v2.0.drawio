6" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="nota" value="O que mudou: Correção: “Selecionar operação” passou a ser decisão (losango). Incluídas as salas e o bloqueio de remoção quando há aula usando o registro." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1175" width="1300" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="a" value="Acessar modalidades e salas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="264" width="204" height="56" as="geometry"/></mxCell><mxCell id="d" value="Selecionar operação" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="364" width="214" height="88" as="geometry"/></mxCell><mxCell id="c1" value="Informar nome da modalidade ou sala (e capacidade)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="108" y="496" width="214" height="56" as="geometry"/></mxCell><mxCell id="c2" value="Nome único e capacidade ≥ 1?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="108" y="596" width="214" height="88" as="geometry"/></mxCell><mxCell id="c3" value="Exibir erro" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="612" width="204" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Salvar cadastro" style=