965" y="1063"/><mxPoint x="465" y="1063"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#55536a;fontSize=11;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m6" target="fim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="1063"/><mxPoint x="465" y="1063"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="fluxo04" name="04 - Agendamento de aulas"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1367" pageHeight="1467" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Fluxo 04 — Agendamento de aulas" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="req" value="Requisitos: RF19, RF20, RF36, RN09, RN10, RN13, RN14, RN15, RN17  ·  Situação: Atualizado" style="text;html=1;fontSize=12;fontColor=#5a5768;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="nota" value="O que mudou: v2.0: a aula pode acontecer em vários dias da semana no mesmo horário, com vigência opcional (RF36); os conflitos de sala e professor são verificados em todos os dias escolhidos; o professor só agenda e altera as próprias aulas, e desativar ou remover é exclusivo do Administrativo (RN17)." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1407" width="1295" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="a" value="Acessar agenda de aulas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="264" width="204" height="56" as="geometry"/></mxCell><mxCell id="d" value="Nova aula ou aula existente?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="364" width="214" height="88" as="geometry"/></mxCell><mxCell id="nv" value="Iniciar novo agendamento (professor: aula fica em seu nome)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="496" width="204" height="56" as="geometry"/></mxCell><mxCell id="ex" value="Selecionar aula existente (professor: só as próprias)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="496" width="214" height="56" as="geometry"/></mxCell><mxCell id="op" value="Alterar, desativar ou remover?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="596" width="214" height="88" as="geometry"/></mxCell><mxCell id="dados" value="Informar modalidade, dias da semana, horário, sala, professor, mensalidade e vigência" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="v1" value="Entre 18h e 22h, término após o início e vigência coerente?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="712" width="214" height="88" as="geometry"/></mxCell><mxCell id="v2" value="Sala e professor livres em todos os dias escolhidos?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="828" width="214" height="88" as="geometry"/></mxCell><mxCell id="v3" value="Inscritos cabem na sala (até 40)?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="944" width="214" height="88" as="geometry"/></mxCell><mxCell id="rev" value="Revisar dados ou organizar outra turma" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="844" width="204" height="56" as="geometry"/></mxCell><mxCell id="sv" value="Salvar agendamento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="1076" width="204" height="56" as="geometry"/></mxCell><mxCell id="ag" value="Aula disponível na agenda em cada dia escolhido" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="1192" width="214" height="56" as="geometry"/></mxCell><mxCell id="des" value="Desativar aula e encerrar as matrículas (só Administrativo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="rm" value="Aula tem presenças ou matrículas?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="858" y="712" width="214" height="88" as="geometry"/></mxCell><mxCell id="rm1" value="Orientar a desativar (histórico protegido)" st