ão" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="req" value="Requisitos: RF39, RF25, RF37, RN17  ·  Situação: Novo" style="text;html=1;fontSize=12;fontColor=#5a5768;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="nota" value="O que mudou: Fluxo novo (v2.0): comando de terminal que cria o responsavel (Administrativo) e um acesso de professor e um de aluno ligados a cadastros existentes. Não apaga nem duplica dados e pode rodar de novo." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1407" width="800" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="a" value="Rodar portal.py usuarios (opções: --senha, --trocar-senha)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="264" width="214" height="56" as="geometry"/></mxCell><mxCell id="b" value="Senha informada?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="364" width="214" height="88" as="geometry"/></mxCell><mxCell id="g" value="Gerar senha aleatória (exibida uma vez)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613" y="496" width="204" height="56" as="geometry"/></mxCell><mxCell id="v" value="Validar senha forte (aviso se fraca)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="496" width="204" height="56" as="geometry"/></mxCell><mxCell id="c" value="Usuário responsavel já existe?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="596" width="214" height="88" as="geometry"/></mxCell><mxCell id="cr" value="Criar responsavel (Administrativo, superusuário)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="ma" value="Manter (senha só muda com --redefinir)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="p" value="Para Professor e Aluno: escolher o cadastro ativo (ou o informado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="844" width="204" height="56" as="geometry"/></mxCell><mxCell id="d2" value="Cadastro já tem acesso?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="944" width="214" height="88" as="geometry"/></mxCell><mxCell id="k" value="Manter o acesso existente" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="1076" width="214" height="56" as="geometry"/></mxCell><mxCell id="cu" value="Criar usuário com o papel, vincular ao cadastro e marcar troca de senha se pedido" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mx