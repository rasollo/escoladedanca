;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="264" width="204" height="56" as="geometry"/></mxCell><mxCell id="d" value="Usuário é superusuário?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="364" width="214" height="88" as="geometry"/></mxCell><mxCell id="n" value="Exibir acesso negado" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="858" y="496" width="214" height="56" as="geometry"/></mxCell><mxCell id="o" value="Exportar ou restaurar?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="480" width="214" height="88" as="geometry"/></mxCell><mxCell id="e1" value="Gerar arquivo JSON com todos os dados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="612" width="204" height="56" as="geometry"/></mxCell><mxCell id="e2" value="Registrar BACKUP_EXPORTADO na auditoria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="e3" value="Baixar o arquivo (contém dados pessoais: guardar com cuidado)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="108" y="844" width="214" height="56" as="geometry"/></mxCell><mxCell id="r1" value="Enviar o arquivo .json e digitar RESTAURAR" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="r2" value="Confirmação e arquivo válidos (até 50 MB)?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="712" width="214" height="88" as="geometry"/></mxCell><mxCell id="r4" value="Substituir os dados em transação única" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="844" width="204" height="56" as="geometry"/></mxCell><mxCell id="r5" value="Restauração concluída sem erro?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="944" width="214" height="88" as="geometry"/></mxCell><mxCell id="r3" value="Exibir o erro; nenhum dado é alterado" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="960" width="214" height="56" as="geometry"/></mxCell><mxCell id="r7" value="Registrar BACKUP_RESTAURADO e encerrar a sessão" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="1076" width="204" height="56" as="geometry"/></mxCell><mxCell id="r8" value="Entrar novamente" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="1192" width="214" height="56" as="geometry"/></mxCell><mxCell id="fim" value="Fim" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="1315" width="120" height="42" as="geometry"/></mxCell><mxCell id="e0"