;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="496" width="204" height="56" as="geometry"/></mxCell><mxCell id="d" value="Contar inscrições: cada par aluno–aula conta 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="612" width="204" height="56" as="geometry"/></mxCell><mxCell id="e" value="Salário = inscrições × valor por aluno do professor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="f" value="Exibir total e detalhamento por aula" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="844" width="214" height="56" as="geometry"/></mxCell><mxCell id="g" value="Já há salário registrado neste mês?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="944" width="214" height="88" as="geometry"/></mxCell><mxCell id="h" value="Exibir valor já pago e o que falta pagar" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="1076" width="214" height="56" as="geometry"/></mxCell><mxCell id="k" value="Confirmar pagamento?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="1176" width="214" height="88" as="geometry"/></mxCell><mxCell id="n" value="Encerrar sem registrar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="1308" width="204" height