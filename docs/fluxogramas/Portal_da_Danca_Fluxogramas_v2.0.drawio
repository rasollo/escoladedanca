 y="1179"/><mxPoint x="465" y="1179"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="fluxo10" name="10 - Cobranças de mensalidade"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1402" pageHeight="1467" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Fluxo 10 — Cobranças de mensalidade" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="req" value="Requisitos: RF10, RF11, RF23, RF34, RN02, RN04, RN06, RN08, RN12, RN18, RN20  ·  Situação: Atualizado" style="text;html=1;fontSize=12;fontColor=#5a5768;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="nota" value="O que mudou: v2.0: a mensalidade passou a ser uma cobrança mensal por matrícula ativa (mensalidade − desconto, vencimento no dia 5), que não altera o caixa. O recebimento pode ser parcial, até o saldo devedor, e entra como entrada; a correção é por estorno com motivo (saída vinculada); a cobrança só é cancelada sem recebimentos. A situação (pendente, parcial, atrasada ou paga) segue informativa (RN08)." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1407" width="1330" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="a" value="Acessar mensalidades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="264" width="204" height="56" as="geometry"/></mxCell><mxCell id="b" value="Escolher mês ou período e situação; exibir cobranças, totais e contagem por situação" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="380" width="214" height="56" as="geometry"/></mxCell><mxCell id="d" value="Qual operação?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="480" width="214" height="88" as="geometry"/></mxCell><mxCell id="g1" value="Gerar 1 cobrança por matrícula ativa sem cobrança no mês (o caixa não muda)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="612" width="204" height="56" as="geometry"/></mxCell><mxCell id="x" value="Exportar CSV com os filtros escolhidos" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="c" value="Abrir a cobrança do aluno" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="c2" value="Receber, estornar ou cancelar?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="712" width="214" height="88" as="geometry"/></mxCell><mxCell id="e1" value="Selecionar recebimento e informar o motivo do estorno" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="108" y="844" width="214" height="56" as="geometry"/></mxCell><mxCell id="e2" value="Registrar saída de estorno vinculada ao recebimento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="960" width="204" height="56" as="geometry"/></mxCell><mxCell id="r1" value="Informar valor, data e forma de pagamento" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="844" width="214" height="56" as="geometry"/></mxCell><mxCell id="r2" value="0 &lt; valor ≤ saldo devedor?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="944" width="214" height="88" as="geometry"/></mxCell><mxCell id="r3" value="Corrigir o valor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613" y="960" width="204" height="56" as="geometry"/></mxCell><mxCell id="r4" value="Registrar entrada (origem = mensalidade) vinculada à cobrança" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="1076" width="204" height="56" as="geometry"/></mxCell><mxCell id="r5" value="Atualizar saldo e situação: pendente, parcial, atrasada ou paga" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="1192" width="204" height="56" as="geometry"/></mxCell><mxCell id="k1" value="Cobrança tem recebimentos ativos?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="858" y="828" width="214" height="88" as="geometry"/></mxCell><mxCell id="k2" value="Orientar a est