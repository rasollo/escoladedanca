 page="1" pageScale="1" pageWidth="1367" pageHeight="1467" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Fluxo 05 — Matrícula de alunos nas aulas" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="req" value="Requisitos: RF20, RF21, RF24, RF32, RN07, RN08, RN09, RN18, RN20  ·  Situação: Atualizado" style="text;html=1;fontSize=12;fontColor=#5a5768;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="nota" value="O que mudou: v2.0: a matrícula copia a mensalidade da aula e aceita desconto percentual ou fixo (RN18); o Administrativo pode suspender ou cancelar com motivo e reativar a suspensa, respeitando a lotação (RF32, RN20). Matrículas encerradas não geram novas cobranças, mas contam no salário do mês em que estiveram ativas." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1407" width="1295" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="d0" value="Vincular alunos ou gerenciar uma matrícula?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="248" width="214" height="88" as="geometry"/></mxCell><mxCell id="a" value="Selecionar aula agendada (professor: só as próprias)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="380" width="214" height="56" as="geometry"/></mxCell><mxCell id="b" value="Exibir inscritos, capacidade da sala e vagas" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="496" width="214" height="56" as="geometry"/></mxCell><mxCell id="c" value="Marcar alunos a inscrever e desmarcar os que saíram" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="d" value="Total de inscritos ≤ capacidade da sala?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="712" width="214" height="88" as="geometry"/></mxCell><mxCell id="r" value="Revisar seleção ou organizar outra turma" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="113" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="m1" value="Abrir matrícula (início = hoje, mensalidade da aula)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="844" width="204" height="56" as="geometry"/></mxCell><mxCell id="m2" value="Encerrar matrícula (fim = hoje) dos desmarcados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="960" width="204" height="56" as="geometry"/></mxCell><mxCell id="au" value="Registrar a alteração na auditoria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="1076" width="204" height="56" as="geometry"/></mxCell><mxCell id="s" value="Matrículas usadas nas cobranças (fluxo 10) e no salário (fluxo 11)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="1192" width="214" height="56" as="geometry"/></mxCell><mxCell id="g" value="Abrir a matrícula no cadastro do aluno (Administrativo)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="858" y="380" width="214" height="56" as="geometry"/></mxCell><mxCell id="g2" value="Qual ação?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="858" y="480" width="214" height="88" as="geometry"/></mxCell><mxCell id="ed" value="Ajustar mensalidade e desconto (% ou valor fixo)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="en" value="Escolher suspender ou cancelar e informar o motivo" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="858" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="en2" value="Encerrar a matrícula (fim = hoje), sem novas cobranças" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="863" y="728" width="204" height="56" as="geometry"/></mxCell><mxCell id="re" value="Conferir se está suspensa, se a aula está ativa e se há vaga" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1