e=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#55536a;fontSize=11;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="en2" target="fim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="1295"/><mxPoint x="465" y="1295"/></Array></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#55536a;fontSize=11;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="re2" target="fim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="1295"/><mxPoint x="465" y="1295"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="fluxo06" name="06 - Registro de presença e faltas"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1122" pageHeight="1815" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Fluxo 06 — Registro de presença e faltas" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="req" value="Requisitos: RF03, RF04, RF21, RF33, RN08, RN19  ·  Situação: Atualizado" style="text;html=1;fontSize=12;fontColor=#5a5768;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="36" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="nota" value="O que mudou: v2.0: a chamada de cada aula e data fica aberta, concluída ou cancelada (RF33). O professor registra e conclui a chamada das próprias aulas; uma chamada concluída só é corrigida pela administração, com motivo; a aula só é cancelada sem registros e com motivo (RN19). Mantidos os avulsos, o dia da aula e a capacidade." style="text;html=1;fontSize=11;fontColor=#5a5768;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="1755" width="1050" height="50" as="geometry"/></mxCell><mxCell id="i" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e3f2ea;strokeColor=#2f7a55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="120" height="42" as="geometry"/></mxCell><mxCell id="a" value="Selecionar aula e data (professor: só as próprias)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="264" width="214" height="56" as="geometry"/></mxCell><mxCell id="d1" value="A aula acontece nessa data (dia e vigência)?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="364" width="214" height="88" as="geometry"/></mxCell><mxCell id="x" value="Informar o dia correto da aula" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1fa;strokeColor=#4a5a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613" y="380" width="204" height="56" as="geometry"/></mxCell><mxCell id="st" value="Situação da chamada?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="358" y="480" width="214" height="88" as="geometry"/></mxCell><mxCell id="ca" value="Exibir aula cancelada e o motivo" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#f5effb;strokeColor=#6a4a8c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="108" y="612" width="214" height="56" as="geometry"/></mxCell><mxCell id="co" value="Usuário é da administração?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff4dc;strokeColor=#a8761a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="608" y="596" width="214" height="8